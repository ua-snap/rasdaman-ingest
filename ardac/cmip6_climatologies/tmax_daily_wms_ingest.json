{
  "config": {
    "service_url": "https://localhost/rasdaman/ows",
    "tmp_directory": "/tmp/",
    "crs_resolver": "https://localhost/def/",
    "default_null_values": [
      "nan"
    ],
    "mock": false,
    "automated": true
  },
  "input": {
    "coverage_id": "cmip6_wrf_climatologies_tmax_daily_wms_crstephenson",
    "paths": [
      "cmip6_wrf_climatologies_tmax_daily_wms.nc"
    ]
  },
  "recipe": {
    "name": "general_coverage",
    "options": {
      "wms_import": true,
      "import_order": "ascending",
      "tiling": "ALIGNED [0:0, 0:0, 0:364, 0:52, 0:52] tile size 4194304",
      "coverage": {
        "crs": "OGC/0/Index1D?axis-label=\"scenario\"@OGC/0/Index1D?axis-label=\"era\"@OGC/0/Index1D?axis-label=\"dayofyear\"@EPSG/0/3338",
        "metadata": {
          "type": "xml",
          "global": "auto"
        },
        "slicer": {
          "type": "netcdf",
          "pixelIsPoint": true,
          "bands": [
            {
              "name": "tmax",
              "identifier": "tmax",
              "nilValue": "nan"
            }
          ],
          "axes": {
            "scenario": {
              "min": "${netcdf:variable:scenario:min}",
              "max": "${netcdf:variable:scenario:max}",
              "directPositions": "${netcdf:variable:scenario}",
              "irregular": true,
              "gridOrder": 0
            },
            "era": {
              "min": "${netcdf:variable:era:min}",
              "max": "${netcdf:variable:era:max}",
              "directPositions": "${netcdf:variable:era}",
              "irregular": true,
              "gridOrder": 1
            },
            "dayofyear": {
              "min": "${netcdf:variable:dayofyear:min}",
              "max": "${netcdf:variable:dayofyear:max}",
              "resolution": 1,
              "gridOrder": 2
            },
            "Y": {
              "min": "${netcdf:variable:y:min}",
              "max": "${netcdf:variable:y:max}",
              "resolution": "${netcdf:variable:y:resolution}",
              "gridOrder": 3
            },
            "X": {
              "min": "${netcdf:variable:x:min}",
              "max": "${netcdf:variable:x:max}",
              "resolution": "${netcdf:variable:x:resolution}",
              "gridOrder": 4
            }
          }
        }
      }
    }
  },
  "hooks": [
    {
      "description": "Create style counting days with tmax >= a user-provided threshold (GetMap parameter @threshold, in degC); scenario and era are chosen with the usual dim_* GetMap parameters. Buckets (days): 0, 1-29, 30-89, 90-179, 180+. NaN cells stay NaN.",
      "when": "after_import",
      "cmd": ". /etc/default/rasdaman; curl --user $RASCURL \"https://datacubes.earthmaps.io/rasdaman/admin/layer/style/add?COVERAGEID=cmip6_wrf_climatologies_tmax_daily_wms_crstephenson&STYLEID=ardac_tmax_days_above_threshold&ABSTRACT=Number%20of%20days%20per%20year%20with%20daily%20maximum%20temperature%20greater%20than%20or%20equal%20to%20the%20%40threshold%20%28degC%29%20GetMap%20parameter&WCPSQUERYFRAGMENT=%28condense%20%2B%20over%20%24d%20dayofyear%280%3A364%29%20using%20%28%28float%29%28%24c.tmax%5Bdayofyear%28%24d%29%5D%20%3E%3D%20%40threshold%29%20%2B%200%20%2A%20%24c.tmax%5Bdayofyear%28%24d%29%5D%29%29&COLORTABLETYPE=ColorMap&\" --data-urlencode \"COLORTABLEDEFINITION={\\\"type\\\":\\\"intervals\\\",\\\"colorTable\\\":{\\\"-9999\\\":[0,0,0,0],\\\"0\\\":[255,255,178,255],\\\"1\\\":[254,204,92,255],\\\"30\\\":[253,141,60,255],\\\"90\\\":[240,59,32,255],\\\"180\\\":[189,0,38,255]}}\"",
      "abort_on_error": true
    }
  ]
}
