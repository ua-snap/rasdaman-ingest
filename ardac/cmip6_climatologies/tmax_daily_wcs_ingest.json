{
  "config": {
    "service_url": "https://localhost/rasdaman/ows",
    "tmp_directory": "/tmp/",
    "crs_resolver": "https://localhost/def/",
    "default_null_values": [
      "nan"
    ],
    "mock": false,
    "automated": true
  },
  "input": {
    "coverage_id": "cmip6_wrf_climatologies_tmax_daily_wcs_crstephenson",
    "paths": [
      "split/cmip6_wrf_climatologies_tmax_daily_wcs_y*.nc"
    ]
  },
  "recipe": {
    "name": "general_coverage",
    "options": {
      "wms_import": false,
      "import_order": "ascending",
      "tiling": "ALIGNED [0:14, 0:4, 0:2, 0:364, 0:2, 0:0, 0:0] tile size 1048576",
      "coverage": {
        "crs": "OGC/0/Index1D?axis-label=\"model\"@OGC/0/Index1D?axis-label=\"scenario\"@OGC/0/Index1D?axis-label=\"era\"@OGC/0/Index1D?axis-label=\"dayofyear\"@OGC/0/Index1D?axis-label=\"aggregation\"@EPSG/0/3338",
        "metadata": {
          "type": "xml",
          "global": "auto"
        },
        "slicer": {
          "type": "netcdf",
          "pixelIsPoint": true,
          "bands": [
            {
              "name": "tmax",
              "identifier": "tmax",
              "nilValue": "nan"
            }
          ],
          "axes": {
            "model": {
              "min": "${netcdf:variable:model:min}",
              "max": "${netcdf:variable:model:max}",
              "directPositions": "${netcdf:variable:model}",
              "irregular": true,
              "gridOrder": 0
            },
            "scenario": {
              "min": "${netcdf:variable:scenario:min}",
              "max": "${netcdf:variable:scenario:max}",
              "directPositions": "${netcdf:variable:scenario}",
              "irregular": true,
              "gridOrder": 1
            },
            "era": {
              "min": "${netcdf:variable:era:min}",
              "max": "${netcdf:variable:era:max}",
              "directPositions": "${netcdf:variable:era}",
              "irregular": true,
              "gridOrder": 2
            },
            "dayofyear": {
              "min": "${netcdf:variable:dayofyear:min}",
              "max": "${netcdf:variable:dayofyear:max}",
              "resolution": 1,
              "gridOrder": 3
            },
            "aggregation": {
              "min": "${netcdf:variable:aggregation:min}",
              "max": "${netcdf:variable:aggregation:max}",
              "directPositions": "${netcdf:variable:aggregation}",
              "irregular": true,
              "gridOrder": 4
            },
            "Y": {
              "min": "${netcdf:variable:y:min}",
              "max": "${netcdf:variable:y:max}",
              "resolution": "${netcdf:variable:y:resolution}",
              "gridOrder": 5
            },
            "X": {
              "min": "${netcdf:variable:x:min}",
              "max": "${netcdf:variable:x:max}",
              "resolution": "${netcdf:variable:x:resolution}",
              "gridOrder": 6
            }
          }
        }
      }
    }
  }
}
