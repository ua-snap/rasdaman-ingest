{
  "config": {
    "service_url": "https://localhost/rasdaman/ows",
    "tmp_directory": "/tmp/",
    "mock": false,
    "automated": true
  },
  "input": {
    "coverage_id": "cmip6_isi",
    "paths": [
      "/opt/rasdaman-storage/coverage_data/cmip6_isi/cmip6_isi_combined.nc"
    ]
  },
  "recipe": {
    "name": "general_coverage",
    "options": {
      "tiling": "ALIGNED [0:4, 0:*, 0:1, 0:1] tile size 1643456",
      "wms_import": true,
      "import_order": "ascending",
      "coverage": {
        "crs": "OGC/0/Index1D?axis-label=\"model\"@OGC/0/Index1D?axis-label=\"time\"@EPSG/0/4326",
        "metadata": {
          "type": "xml",
          "global": "auto"
        },
        "slicer": {
          "type": "netcdf",
          "pixelIsPoint": true,
          "bands": [
            {
              "name": "isi",
              "identifier": "isi",
              "nilValue": "nan"
            }
          ],
          "axes": {
            "model": {
              "min": "${netcdf:variable:model:min}",
              "max": "${netcdf:variable:model:max}",
              "directPositions": "${netcdf:variable:model}",
              "irregular": true,
              "gridOrder": 0
            },
            "time": {
              "min": "${netcdf:variable:time:min}",
              "max": "${netcdf:variable:time:max}",
              "directPositions": "${netcdf:variable:time}",
              "irregular": true,
              "gridOrder": 1
            },
            "lat": {
              "min": "${netcdf:variable:lat:min}",
              "max": "${netcdf:variable:lat:max}",
              "resolution": "${netcdf:variable:lat:resolution}",
              "gridOrder": 2
            },
            "lon": {
              "min": "${netcdf:variable:lon:min}",
              "max": "${netcdf:variable:lon:max}",
              "resolution": "${netcdf:variable:lon:resolution}",
              "gridOrder": 3
            }
          }
        }
      }
    }
  },
  "hooks": [
    {
      "description": "Create ISI Style for ARDAC.",
      "when": "after_import",
      "cmd": ". /etc/default/rasdaman; curl --user $RASCURL \"https://datacubes.earthmaps.io/rasdaman/admin/layer/style/add?COVERAGEID=cmip6_isi&STYLEID=ardac_isi&ABSTRACT=isi&WCPSQUERYFRAGMENT=%24c.isi&COLORTABLETYPE=ColorMap&\" --data-urlencode \"COLORTABLEDEFINITION={\\\"type\\\":\\\"ramp\\\",\\\"colorTable\\\":{\\\"-9999\\\":[0,0,0,0],\\\"0\\\":[254,240,217,255],\\\"2\\\":[253,204,138,255],\\\"5\\\":[252,141,89,255],\\\"8\\\":[227,74,51,255],\\\"11\\\":[179,0,0,255]}}\"",
      "abort_on_error": true
    }
  ]
}
