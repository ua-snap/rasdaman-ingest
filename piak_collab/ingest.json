{
  "config": {
    "service_url": "https://localhost/rasdaman/ows",
    "tmp_directory": "/tmp/",
    "mock": false,
    "automated": true
  },
  "input": {
    "coverage_id": "piak_collab_means",
    "paths": [
      "combined_means.nc"
    ]
  },
  "recipe": {
    "name": "general_coverage",
    "options": {
      "tiling": "ALIGNED [0:*, 0:*, 0:*, 0:*, 0:*, 0:*] tile size 4194304",
      "wms_import": true,
      "import_order": "ascending",
      "coverage": {
        "crs": "OGC/0/Index1D?axis-label=\"model\"@OGC/0/Index1D?axis-label=\"scenario\"@OGC/0/Index1D?axis-label=\"position\"@OGC/0/Index1D?axis-label=\"season\"@EPSG/0/4326",
        "metadata": {
          "type": "xml",
          "global": "auto"
        },
        "slicer": {
          "type": "netcdf",
          "pixelIsPoint": true,
          "bands": [
            {
              "name": "mean",
              "identifier": "mean",
              "nilValue": "-9999"
            }
          ],
          "axes": {
            "model": {
              "min": "${netcdf:variable:model:min}",
              "max": "${netcdf:variable:model:max}",
              "directPositions": "${netcdf:variable:model}",
              "irregular": true,
              "gridOrder": 0
            },
            "scenario": {
              "min": "${netcdf:variable:scenario:min}",
              "max": "${netcdf:variable:scenario:max}",
              "directPositions": "${netcdf:variable:scenario}",
              "irregular": true,
              "gridOrder": 1
            },
            "position": {
              "min": "${netcdf:variable:position:min}",
              "max": "${netcdf:variable:position:max}",
              "directPositions": "${netcdf:variable:position}",
              "irregular": true,
              "gridOrder": 2
            },
            "season": {
              "min": "${netcdf:variable:season:min}",
              "max": "${netcdf:variable:season:max}",
              "directPositions": "${netcdf:variable:season}",
              "irregular": true,
              "gridOrder": 3
            },
            "Lon": {
              "min": "${netcdf:variable:Lon:min}",
              "max": "${netcdf:variable:Lon:max}",
              "resolution": "${netcdf:variable:Lon:resolution}",
              "gridOrder": 4
            },
            "Lat": {
              "min": "${netcdf:variable:Lat:min}",
              "max": "${netcdf:variable:Lat:max}",
              "resolution": "${netcdf:variable:Lat:resolution}",
              "gridOrder": 5
            }
          }
        }
      }
    }
  }
}